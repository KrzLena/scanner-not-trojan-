<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.StatsPage"
    Title="Statystyki"
    BackgroundColor="#302A32">

    <VerticalStackLayout
        Padding="25"
        Spacing="15">

        <Label
            Text="Statystyki"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="White"
            HorizontalOptions="Center"
            Margin="0,10,0,20"/>

        <Border
            BackgroundColor="#EEEEEE"
            Padding="20"
            StrokeThickness="0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="18">

                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Text="Wszystkie osoby"
                        TextColor="#302A32"/>

                    <Label
                        x:Name="TotalLabel"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        TextColor="#302A32"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Text="Dodane ręcznie"
                        TextColor="#302A32"/>

                    <Label
                        x:Name="ManualLabel"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        TextColor="#302A32"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Text="Zeskanowane"
                        TextColor="#302A32"/>

                    <Label
                        x:Name="ScannedLabel"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        TextColor="#302A32"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Text="Aktywne dzisiaj"
                        TextColor="#302A32"/>

                    <Label
                        x:Name="TodayLabel"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        TextColor="#302A32"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Text="Ostatnie 7 dni"
                        TextColor="#302A32"/>

                    <Label
                        x:Name="WeekLabel"
                        Grid.Column="1"
                        FontAttributes="Bold"
                        TextColor="#302A32"/>
                </Grid>

            </VerticalStackLayout>

        </Border>

    </VerticalStackLayout>

</ContentPage>