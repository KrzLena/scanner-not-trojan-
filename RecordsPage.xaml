<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.RecordsPage"
    Title="Lista"
    BackgroundColor="#302A32">

    <Grid
        Padding="18"
        RowDefinitions="Auto,Auto,*,Auto,Auto"
        RowSpacing="12">

        <Border
            Grid.Row="0"
            BackgroundColor="#EEEEEE"
            Stroke="#CFCFCF"
            StrokeThickness="1"
            Padding="5,0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>

            <SearchBar
                x:Name="SearchBox"
                Placeholder="Szukaj osoby..."
                TextChanged="SearchChanged"
                BackgroundColor="Transparent"
                TextColor="#302A32"
                PlaceholderColor="#777777"/>

        </Border>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            ColumnSpacing="10">

            <Border
                Grid.Column="0"
                BackgroundColor="#EEEEEE"
                Stroke="#CFCFCF"
                StrokeThickness="1"
                Padding="10,2"
                HeightRequest="55">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <Picker
                    x:Name="SortPicker"
                    Title="Sortowanie"
                    BackgroundColor="Transparent"
                    TextColor="#302A32"
                    TitleColor="#777777"
                    VerticalOptions="Center"
                    SelectedIndexChanged="FilterChanged">

                    <Picker.Items>
                        <x:String>Najnowsze</x:String>
                        <x:String>Najstarsze</x:String>
                        <x:String>Nazwisko A-Z</x:String>
                        <x:String>Imię A-Z</x:String>
                    </Picker.Items>

                </Picker>

            </Border>

            <Border
                Grid.Column="1"
                BackgroundColor="#EEEEEE"
                Stroke="#CFCFCF"
                StrokeThickness="1"
                Padding="10,2"
                HeightRequest="55">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <Picker
                    x:Name="DatePickerFilter"
                    Title="Data"
                    BackgroundColor="Transparent"
                    TextColor="#302A32"
                    TitleColor="#777777"
                    VerticalOptions="Center"
                    SelectedIndexChanged="FilterChanged">

                    <Picker.Items>
                        <x:String>Wszystkie</x:String>
                        <x:String>Dzisiaj</x:String>
                        <x:String>7 dni</x:String>
                    </Picker.Items>

                </Picker>

            </Border>

        </Grid>

        <CollectionView
            x:Name="RecordsView"
            Grid.Row="2"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <SwipeView>

                        <SwipeView.RightItems>

                            <SwipeItems
                                Mode="Reveal"
                                SwipeBehaviorOnInvoked="Close">

                                <SwipeItem
                                    Text="Edytuj"
                                    BackgroundColor="#77727B"
                                    CommandParameter="{Binding .}"
                                    Invoked="EditSwipeInvoked"/>

                                <SwipeItem
                                    Text="Usuń"
                                    BackgroundColor="#A64A4A"
                                    CommandParameter="{Binding .}"
                                    Invoked="DeleteSwipeInvoked"/>

                            </SwipeItems>

                        </SwipeView.RightItems>

                        <Grid
                            ColumnDefinitions="45,*"
                            Padding="0,5">

                            <CheckBox
                                Grid.Column="0"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                CheckedChanged="SelectionChanged"
                                Color="White"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"/>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#F2F2F2"
                                Stroke="#D8D8D8"
                                StrokeThickness="1"
                                Padding="15,10"
                                MinimumHeightRequest="70">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="RecordTapped"/>
                                </Border.GestureRecognizers>

                                <Grid
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="4">

                                    <Label
                                        Grid.Row="0"
                                        Text="{Binding FullName}"
                                        TextColor="#27232A"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"/>

                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding ListInfoText}"
                                        TextColor="#777777"
                                        FontSize="12"/>

                                </Grid>

                            </Border>

                        </Grid>

                    </SwipeView>

                </DataTemplate>

            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="5">

                    <Label
                        Text="Brak rekordów"
                        TextColor="#D0CCD2"
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Zeskanuj QR lub dodaj osobę."
                        TextColor="#99949C"
                        FontSize="13"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

        </CollectionView>

        <Label
            x:Name="CountLabel"
            Grid.Row="3"
            Text="Liczba rekordów: 0"
            TextColor="#B9B4BC"
            HorizontalOptions="Center"
            FontSize="13"/>

        <Grid
            Grid.Row="4"
            ColumnDefinitions="*,*,*,*"
            ColumnSpacing="7">

            <Button
                Grid.Column="0"
                Text="Skanuj"
                Clicked="ScanClicked"
                BackgroundColor="#EEEEEE"
                TextColor="#302A32"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="55"/>

            <Button
                Grid.Column="1"
                Text="Dodaj"
                Clicked="AddClicked"
                BackgroundColor="#789B81"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="55"/>

            <Button
                x:Name="DeleteButton"
                Grid.Column="2"
                Text="Usuń"
                Clicked="DeleteClicked"
                BackgroundColor="#A85C5C"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="55"
                IsEnabled="False"/>

            <Button
                Grid.Column="3"
                Text="Więcej"
                Clicked="MoreClicked"
                BackgroundColor="#EEEEEE"
                TextColor="#302A32"
                FontSize="14"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="55"/>

        </Grid>

    </Grid>

</ContentPage>
